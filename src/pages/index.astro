---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import ProjectCard from '../components/ProjectCard';
import ThemeToggle from '../components/ThemeToggle';
import SectionTitle from '../components/SectionTitle';

const projects = [
  {
    title: 'Benchmarks',
    description: 'Performance benchmarking suite for Python, CUDA, and various compute workloads.',
    tags: ['Python', 'Benchmark', 'GPU'],
    github: 'https://github.com/TheFirstIstari/Benchmarks',
  },
  {
    title: 'Coursework Repo',
    description: 'C# algorithms, data structures and practice exercises.',
    tags: ['C#', 'Algorithms'],
    github: 'https://github.com/TheFirstIstari/CourseWorkRepo',
  },
  {
    title: 'TrackBound',
    description: 'Realtime GPS track analysis, smoothing and lightweight map visualizations.',
    tags: ['Rust', 'Python', 'GIS'],
    github: 'https://github.com/TheFirstIstari/TrackBound',
  },
  {
    title: 'Project SteinLine',
    description: 'Distributed forensic pipeline — multimodal AI, edge storage and Qt visualization.',
    tags: ['Python', 'AI', 'GPU', 'Qt'],
    github: 'https://github.com/TheFirstIstari/Project-SteinLine',
    more: '/projects#steinline',
  },
  {
    title: 'BadAppleStein',
    description: 'Frame-to-PDF matching pipeline using Python and C for fast matching.',
    tags: ['Python', 'C', 'FFmpeg'],
    github: 'https://github.com/TheFirstIstari/BadAppleStein',
    demo: 'https://www.youtube.com/watch?v=Ia1wR8HScm0',
  },
  {
    title: 'CCC - GCC Studio',
    description: 'Interactive web UI to compare GCC and Claude\'s C Compiler assembly.',
    tags: ['Python', 'C', 'Web'],
    github: 'https://github.com/TheFirstIstari/GCC-CCC-comparison',
  },
];
---

<Layout title="TheFirstIstari | Projects">
  <ThemeToggle client:load />
  
  <main class="min-h-screen">
    <Hero client:load />
    
    <section class="py-20 px-4 max-w-6xl mx-auto" id="projects">
      <SectionTitle 
        client:visible
        title="Projects"
        description="A collection of projects spanning algorithms, AI, systems programming, and creative experiments."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project, index) => (
          <ProjectCard
            client:visible
            title={project.title}
            description={project.description}
            tags={project.tags}
            github={project.github}
            demo={project.demo}
            more={project.more}
            index={index}
          />
        ))}
      </div>
    </section>

    <section class="py-20 px-4 max-w-4xl mx-auto" id="contact">
      <SectionTitle 
        client:visible
        title="Get in Touch"
        description="Feel free to reach out for collaborations, questions, or just to say hi."
      />
      
      <div class="flex flex-wrap gap-4 justify-center">
        <a
          href="https://github.com/TheFirstIstari"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-full border border-[rgba(255,255,255,0.2)] text-[rgba(251,251,255,0.8)] hover:border-[#028090] hover:text-[#028090] transition-colors"
        >
          GitHub
        </a>
      </div>
    </section>

    <footer class="py-8 text-center text-[rgba(251,251,255,0.4)] text-sm">
      <p>© {new Date().getFullYear()} TheFirstIstari. All rights reserved.</p>
    </footer>
  </main>
</Layout>