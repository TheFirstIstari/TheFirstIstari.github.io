---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import { featuredProjects } from '../data/projects';
---

<Layout title="TheFirstIstari | Portfolio" description="TheFirstIstari — systems engineer">

  <!-- ========== PORTRAIT + NAME ========== -->
  <div class="slide-group" id="slideGroup">
    <div class="portrait-section" id="portraitSection">
      <div class="portrait-frame" id="portraitFrame">
        <img
          class="portrait-base"
          id="portraitBase"
          src="https://github.com/TheFirstIstari.png"
          alt="TheFirstIstari"
          draggable="false"
          width="400"
          height="400"
          fetchpriority="high"
        />
        <canvas class="illustration-canvas" id="illustrationCanvas"></canvas>
      </div>
    </div>

    <div class="name-section" id="nameSection" aria-label="TheFirstIstari">
      <div class="name-display" id="nameDisplay">
        <!-- ponytail: no subtitle, just the name -->
      </div>
    </div>
  </div>

  <Hero client:load />

  <!-- Projects -->
  <section class="projects-section" id="projects">
    <div class="projects-list">
      {featuredProjects.map((project) => (
        <a
          href={project.site || project.github || '#'}
          target="_blank"
          rel="noopener noreferrer"
          class="project-row"
        >
          <span class="project-row-title">{project.title}</span>
          {project.status && <span class="project-row-status">{project.status}</span>}
        </a>
      ))}
    </div>
  </section>

  <footer class="site-footer">
    &copy; {new Date().getFullYear()} TheFirstIstari
  </footer>
</Layout>