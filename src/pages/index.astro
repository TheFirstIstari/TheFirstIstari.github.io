---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero';
import ProjectCard from '../components/ProjectCard';
import SectionTitle from '../components/SectionTitle';
import Skills from '../components/Skills';
import About from '../components/About';
import { featuredProjects } from '../data/projects';
---

<Layout title="TheFirstIstari | Portfolio" description="TheFirstIstari — systems engineer">

  <!-- ========== PORTRAIT + NAME (slide together) ========== -->
  <div class="slide-group" id="slideGroup" aria-hidden="true">

    <div class="portrait-section" id="portraitSection">
      <div class="portrait-frame" id="portraitFrame">
        <img
          class="portrait-base"
          id="portraitBase"
          src="https://github.com/TheFirstIstari.png"
          alt="TheFirstIstari, systems engineer"
          draggable="false"
          width="400"
          height="400"
          fetchpriority="high"
        />
        <canvas class="illustration-canvas" id="illustrationCanvas"></canvas>
      </div>
    </div>

    <div class="name-section" id="nameSection" aria-label="TheFirstIstari">
      <div class="name-display" id="nameDisplay">
        <!-- Slots injected by Hero component / JS -->
      </div>
      <p class="hero-subtitle">Systems Engineer</p>
    </div>

  </div><!-- /slide-group -->

  <!-- Below the fold -->
  <About client:visible />
  <Skills client:visible />

  <section class="projects-section" id="projects">
    <div style="margin-bottom: 32px;">
      <h2 class="section-title">Projects</h2>
      <p class="section-desc">Selected work.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featuredProjects.map((project, index) => (
        <ProjectCard
          client:visible
          title={project.title}
          description={project.description}
          tags={project.tags}
          github={project.github}
          demo={project.demo}
          site={project.site}
          status={project.status}
          index={index}
        />
      ))}
    </div>

    <div class="mt-10 text-center">
      <a
        href="/projects/"
        class="project-link"
      >
        View all projects &mdash;
      </a>
    </div>
  </section>

  <footer class="site-footer">
    &copy; {new Date().getFullYear()} TheFirstIstari
  </footer>
</Layout>