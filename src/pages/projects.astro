---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ThemeToggle';
import ProjectCard from '../components/ProjectCard';
import SectionTitle from '../components/SectionTitle';
import FluidBackground from '../components/FluidBackground';
import { allTags, projects } from '../data/projects';
---

<Layout title="TheFirstIstari | Projects" description="All projects by TheFirstIstari — systems programming, performance, security, cryptography, data visualisation and more.">
  <FluidBackground />
  <ThemeToggle client:load />
  
  <main class="relative z-10 min-h-screen py-20 px-4">
    <div class="max-w-6xl mx-auto">
      <a href="/" class="inline-flex items-center gap-2 transition-colors mb-8" style="color: var(--text-muted);">
        &larr; Back
      </a>
      
      <SectionTitle 
        client:visible
        title="All Projects"
        description="everything — systems, performance, security, cryptography, data visualisation, realtime apps and creative tooling."
      />

      <div class="mb-8">
        <p class="text-xs mb-3" style="color: var(--comment);">Filter by tag</p>
        <div class="flex flex-wrap gap-2">
          <button
            class="tag-btn active px-3 py-1.5 rounded-md text-xs transition-colors"
            data-tag="all"
            style="border: 1px solid var(--border); color: var(--text-muted);"
          >
            all
          </button>
          {allTags.map(tag => (
            <button
              class="tag-btn px-3 py-1.5 rounded-md text-xs transition-colors"
              data-tag={tag}
              style="border: 1px solid var(--border); color: var(--text-muted);"
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6" id="projects-grid">
        {projects.map((project, index) => (
          <ProjectCard
            client:visible
            title={project.title}
            description={project.description}
            tags={project.tags}
            github={project.github}
            demo={project.demo}
            site={project.site}
            status={project.status}
            index={index}
            id={project.id}
            detail={project.detail}
          />
        ))}
      </div>
    </div>
  </main>
</Layout>

<script>
  function initProjectsPage() {
    const buttons = document.querySelectorAll<HTMLElement>('.tag-btn');
    if (!buttons.length) return;
    const cards = document.querySelectorAll('article');

    const setActive = (btn: HTMLElement) => {
      buttons.forEach(b => {
        b.style.borderColor = 'var(--border)';
        b.style.color = 'var(--text-muted)';
        b.style.background = 'transparent';
      });
      btn.style.borderColor = 'var(--accent)';
      btn.style.color = 'var(--accent)';
      btn.style.background = 'var(--tag-bg)';
    };

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        setActive(btn);

        cards.forEach(card => {
          const cardTags = card.getAttribute('data-tags')?.split(',') || [];
          if (tag === 'all' || (tag && cardTags.includes(tag))) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    setActive(buttons[0]);

    const hash = window.location.hash;
    if (hash) {
      const el = document.querySelector(hash);
      if (el) {
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 300);
      }
    }
  }

  document.addEventListener('astro:page-load', initProjectsPage);
</script>
