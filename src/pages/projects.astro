---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard';
import SectionTitle from '../components/SectionTitle';
import { allTags, projects } from '../data/projects';
---

<Layout title="TheFirstIstari | Projects" description="All projects by TheFirstIstari">
  <main style="position: relative; z-index: 10; min-height: 100vh; padding: 6rem 1.5rem 2rem;">
    <div class="max-w-6xl mx-auto">
      <a href="/" class="back-link">
        &larr; Back
      </a>
      
      <SectionTitle 
        client:visible
        title="All Projects"
      />

      <div class="mb-8">
        <p class="filter-label">Filter by tag</p>
        <div class="flex flex-wrap gap-2">
          <button
            class="tag-btn active"
            data-tag="all"
          >
            All
          </button>
          {allTags.map(tag => (
            <button
              class="tag-btn"
              data-tag={tag}
            >
              {tag}
            </button>
          ))}
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="projects-grid">
        {projects.map((project, index) => (
          <ProjectCard
            client:visible
            title={project.title}
            description={project.description}
            tags={project.tags}
            github={project.github}
            demo={project.demo}
            site={project.site}
            status={project.status}
            index={index}
            id={project.id}
            detail={project.detail}
          />
        ))}
      </div>
    </div>
  </main>

  <footer>
    &copy; {new Date().getFullYear()} TheFirstIstari
  </footer>
</Layout>

<script>
  function initProjectsPage() {
    const buttons = document.querySelectorAll<HTMLElement>('.tag-btn');
    if (!buttons.length) return;
    const cards = document.querySelectorAll('article');

    const setActive = (btn: HTMLElement) => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    };

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const tag = btn.getAttribute('data-tag');
        setActive(btn);

        cards.forEach(card => {
          const cardTags = card.getAttribute('data-tags')?.split(',') || [];
          if (tag === 'all' || (tag && cardTags.includes(tag))) {
            (card as HTMLElement).style.display = 'block';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });

    setActive(buttons[0]);

    const hash = window.location.hash;
    if (hash) {
      const el = document.querySelector(hash);
      if (el) {
        setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 300);
      }
    }
  }

  document.addEventListener('astro:page-load', initProjectsPage);
</script>
